## 动态键前缀模式（点名为运行时变量的键，无法静态枚举）：
##   [前缀, 中文模板（%s 处替换点名/序号）]
## 与 core 侧动态键生成一一对应：
##   network/traverse/variance_est "x_%s_m"/"y_%s_m"、gnss_net "X/Y/Z_%s_m"、
##   leveling "H_%s_m"、network 精度 "mp/sx/sy_%s_mm"、c5 误差椭圆
##   "ell_%s_A_mm/_B_mm/_phiE_deg"、roadbed "edge_/foot_/edge_diff_%s…"、
##   reliability/c10 "r_i_%d"/"w_%d"/"flag_%d"。
## （photogrammetry "x%d/y%d" 与 geology "station_%d_*" 模板随域下线删除；
##  仅历史 JSON 快照可能仍含这些键——回放时按未收录键口径回退原键名。）
const PREFIX_PATTERNS := [
	["x_%s_m", "点 %s 的 X 坐标（m）"],
	["y_%s_m", "点 %s 的 Y 坐标（m）"],
	["X_%s_m", "点 %s 的 X 坐标（m）"],
	["Y_%s_m", "点 %s 的 Y 坐标（m）"],
	["Z_%s_m", "点 %s 的 Z 坐标（m）"],
	["H_%s_m", "点 %s 的高程（m）"],
	["mp_%s_mm", "点 %s 点位中误差（mm）"],
	["sx_%s_mm", "点 %s X 中误差（mm）"],
	["sy_%s_mm", "点 %s Y 中误差（mm）"],
	["ell_%s_A_mm", "点 %s 误差椭圆长半轴 A（mm）"],
	["ell_%s_B_mm", "点 %s 误差椭圆短半轴 B（mm）"],
	["ell_%s_phiE_deg", "点 %s 误差椭圆长轴方位 E（°）"],
	["edge_%s_elev_m", "路基 %s 边缘高程（m）"],
	["foot_%s_dist_m", "路基 %s 边桩距离（m）"],
	["foot_%s_elev_m", "路基 %s 边桩地面高程（m）"],
	["foot_%s_offset_m", "路基 %s 边桩偏距（m）"],
	["edge_diff_%s_m", "路基 %s 边缘差（m）"],
	["mode_%s", "路基 %s 施工方式"],
	["slope_%s", "路基 %s 边坡"],
	["r_i_%d", "观测 %d 的多余观测分量 rᵢ"],
