	["flag_%d", "观测 %d 的粗差标记"],
]

## 键名 → 中文标签；未收录键回退原键名并告警一次。
## 例：label_for("x_m") → "X 坐标（m）"；label_for("nope") → "nope"（+告警）。
## domain 非空时先查该域子表（计算器级覆盖），未命中回落通用表。
## 动态键（如 "x_P1_m" / "ell_P1_A_mm"）先查精确表，再按 PREFIX_PATTERNS
## 前缀模板替换点名/序号；两者皆不中才回退。
static func label_for(key: String, domain := "") -> String:
	if domain != "" and DOMAIN_LABELS.has(domain):
		var sub: Dictionary = DOMAIN_LABELS[domain]
		if sub.has(key):
			return String(sub[key])
	if LABELS.has(key):
		return String(LABELS[key])
	for pat: Array in PREFIX_PATTERNS:
		var tpl: String = pat[0]
		var star := tpl.find("%s")
		var star_d := tpl.find("%d")
		var head: String
		var tail: String
		var use_d := star_d >= 0 and (star < 0 or star_d < star)
		if use_d:
			head = tpl.substr(0, star_d)
			tail = tpl.substr(star_d + 2)  # "%d" 占 2 字符
		else:
			head = tpl.substr(0, star)
			tail = tpl.substr(star + 2)  # "%s" 占 2 字符（此前误写 +3 会吞掉后缀首字符）
		if key.begins_with(head) and key.ends_with(tail) and key.length() > head.length() + tail.length():
			var mid := key.substr(head.length(), key.length() - head.length() - tail.length())
			if use_d and not mid.is_valid_int():
				continue
			# %d 模板要求整数参数，%s 模板接受字符串
			return String(pat[1]) % (int(mid) if use_d else mid)
	if not _warned.has(key):
		_warned[key] = true
		push_warning("[ui_labels] 未收录键名，回退原键名：" + key)
	return key

## 已收录判断（测试/调试用）
static func has_label(key: String) -> bool:
	return LABELS.has(key)

## 重置去重缓存（测试隔离用）
static func reset_warnings() -> void:
	_warned.clear()
